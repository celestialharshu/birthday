# Backend / database
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/birthday?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Gmail SMTP (use a Google App Password, not your normal Gmail password)
GMAIL_USER=your-gmail@example.com
GMAIL_APP_PASSWORD=16-letter-google-app-password

# Payment display details
UPI_ID=yourupi@bank
UPI_NAME=Your Name

# Payment safety: require a 12-digit UTR before a paid pass is issued
REQUIRE_UTR=true

# Optional. If omitted on Vercel, the app can use the Vercel deployment URL fallback added in api/index.js.
APP_URL=https://your-project.vercel.app
